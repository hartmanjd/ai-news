# Copy this file, rename the copy to ".env", and fill in your values.
# This is only for running the app on your own computer.
# NEVER upload your real .env to GitHub (the .gitignore file blocks it).

DEEPSEEK_API_KEY=sk-your-key-here

# Where the page lives online (from GitHub Pages)
PAGE_BASE_URL=https://yourname.github.io/ai-news/

# Push notifications (free) - make up a hard-to-guess name
NTFY_TOPIC=justin-ai-news-change-this-7x93k

# Text messages (optional, paid)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBERS=
